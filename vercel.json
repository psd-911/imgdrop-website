{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/png-to-jpg", "destination": "/png-to-jpg.html" },
    { "source": "/webp-to-jpg", "destination": "/webp-to-jpg.html" },
    { "source": "/jpg-to-png", "destination": "/jpg-to-png.html" },
    { "source": "/image-compressor", "destination": "/compress.html" },
    { "source": "/compress", "destination": "/compress.html" },
    { "source": "/image-resizer", "destination": "/resize.html" },
    { "source": "/resize", "destination": "/resize.html" },
    { "source": "/image-cropper", "destination": "/crop.html" },
    { "source": "/crop", "destination": "/crop.html" },
    { "source": "/jpg-to-pdf", "destination": "/pdf.html" },
    { "source": "/pdf", "destination": "/pdf.html" },
    { "source": "/compress-image-to-50kb", "destination": "/compress-image-to-50kb.html" },
    { "source": "/compress-image-to-20kb", "destination": "/compress-image-to-20kb.html" },
    { "source": "/compress-image-to-100kb", "destination": "/compress-image-to-100kb.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/cookies", "destination": "/cookies.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
